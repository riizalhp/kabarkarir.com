# Supabase Configuration
# Get these values from: Supabase Dashboard > Settings > API

# Project URL (looks like: https://xxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Anon/Public Key (starts with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Instructions:
# 1. Copy this file and rename to: .env
# 2. Go to Supabase Dashboard → Settings → API
# 3. Copy "Project URL" and paste above (replace "your_supabase_project_url_here")
# 4. Copy "anon public" key and paste above (replace "your_supabase_anon_key_here")
# 5. Save the .env file
# 6. DO NOT commit .env file to Git (it's already in .gitignore)
